<script>
    // 1. Validação do Termo de Aceite de Logística
    function validarTermo() {
        const chk = document.getElementById('chk-aceite');
        const btnZap = document.getElementById('btn-zap');
        const btnPgto = document.getElementById('btn-pagamento');
        
        if (chk.checked) {
            // Destrava os botões se o cliente aceitar as condições de Mairiporã
            btnZap.style.pointerEvents = "auto";
            btnZap.style.opacity = "1";
            btnZap.href = "https://whatsapp.com.";
            
            btnPgto.style.pointerEvents = "auto";
            btnPgto.style.opacity = "1";
        } else {
            // Trava se desmarcar
            btnZap.style.pointerEvents = "none";
            btnZap.style.opacity = "0.5";
            btnZap.href = "#";
            btnPgto.style.pointerEvents = "none";
            btnPgto.style.opacity = "0.5";
        }
    }

    // 2. Interface de Pagamento RecargaPay
    function abrirSistemasPagamento() {
        document.getElementById('bloco-pagamento').style.display = 'block';
    }

    // 3. Copiar Código Pix Copie e Cole
    function copiarChavePix() {
        const inputPix = document.getElementById('pix-copie-cole');
        inputPix.select();
        inputPix.setSelectionRange(0, 99999);
        navigator.clipboard.writeText(inputPix.value);
        alert("✓ Código Pix copiado com sucesso para o RecargaPay!");
    }

    // 4. O Tranco na Barra de Progresso da API
    function dispararFluxoProcessamento(tipo) {
        document.getElementById('container-progresso').style.display = 'block';
        const barra = document.getElementById('barra-progresso');
        const texto = document.getElementById('texto-progresso');
        let progresso = 0;

        const intervalo = setInterval(() => {
            progresso += 5;
            barra.style.width = progresso + '%';
            
            if (progresso === 30) texto.textContent = "⚡ Autenticando com Bradesco Agro...";
            if (progresso === 60) texto.textContent = "📊 Verificando Estoque (Máx 8 Cartelas)...";
            if (progresso === 90) texto.textContent = "🔊 Ativando retorno sonoro do criatório...";

            if (progresso >= 100) {
                clearInterval(intervalo);
                texto.textContent = "✓ Conexão Concluída com Sucesso!";
                tocarSomObrigado();
                alert("📢 SISTEMA JCS:\nPix identificado! Seu pedido foi encaminhado para a logística da Rodoviária.");
            }
        }, 150);
    }

    // 5. O Som das Codornas (A Festa do Criatório)
    function tocarSomObrigado() {
        // Aqui o sistema faz o som tocar para animar a lida
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        // Som de confirmação do JCS_Software
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        
        osc.type = 'sine';
        osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // Nota Dó
        osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.3); // Sobe para o Lá
        
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
        
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        
        osc.start();
        osc.stop(audioCtx.currentTime + 0.4);
    }

    // 6. Painel do Administrador (Alternar Manutenção ON/OFF)
    let sistemaOnline = true;
    function alternarStatus() {
        const btn = document.getElementById('btn-status');
        const telaManutencao = document.getElementById('manutencao-tela');
        const containerCheckout = document.getElementById('jcs-checkout-container');

        if (sistemaOnline) {
            btn.textContent = "Status: MANUTENÇÃO";
            btn.style.backgroundColor = "#cc092f";
            telaManutencao.style.display = "block";
            containerCheckout.style.display = "none";
            sistemaOnline = false;
        } else {
            btn.textContent = "Status: ONLINE";
            btn.style.backgroundColor = "#25D366";
            telaManutencao.style.display = "none";
            containerCheckout.style.display = "block";
            sistemaOnline = true;
        }
    }

    // Checa se o Administrador acessou via URL (?adm=1)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('adm') === '1') {
        document.getElementById('painel-adm').style.style.display = 'block';
    }
</script>
</body>
</html>
