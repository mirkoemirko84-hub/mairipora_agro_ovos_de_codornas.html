<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>JCS Admin App</title>
    <!-- Configuração para abrir em tela cheia como App no celular -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#17509e">
    
    <style>
        /* Estilo Limpo e Direto do MIT App Inventor */
        body {
            font-family: Arial, sans-serif;
            background-color: #EFEFEF;
            margin: 0;
            padding: 0;
            user-select: none;
        }
        .app-header {
            background-color: #17509e;
            color: white;
            padding: 15px;
            font-size: 20px;
            font-weight: bold;
            text-align: center;
            box-shadow: 0px 2px 5px rgba(0,0,0,0.2);
        }
        .app-container {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .app-label {
            font-size: 16px;
            color: #333333;
            font-weight: bold;
            margin-bottom: -5px;
        }
        .status-box {
            background-color: #ffffff;
            border: 2px solid #cccccc;
            border-radius: 8px;
            padding: 12px;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
        }
        .status-online { color: #25D366; }
        .status-manutencao { color: #cc092f; }

        .app-button {
            width: 100%;
            padding: 18px;
            font-size: 18px;
            font-weight: bold;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0px 3px 0px rgba(0,0,0,0.2);
            transition: transform 0.1s;
        }
        .app-button:active { transform: scale(0.98); }
        .btn-green { background-color: #25D366; }
        .btn-red { background-color: #cc092f; }
        .btn-blue { background-color: #007bff; }

        .app-notifier {
            background-color: #333;
            color: white;
            padding: 10px;
            border-radius: 5px;
            text-align: center;
            position: fixed;
            bottom: 20px;
            left: 20px;
            right: 20px;
            display: none;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <div class="app-header">JCS_Software - Painel de Controle</div>

    <div class="app-container">
        
        <div class="app-label">Status Atual do Site Principal:</div>
        <div id="app-status-tela" class="status-box status-online">● SITE ONLINE</div>

        <hr style="width:100%; border:0; border-top:1px solid #ccc; margin:10px 0;">

        <div class="app-label">Comandos Rápidos (Mairiporã):</div>
        
        <button class="app-button btn-red" onclick="comandoMudarStatus('manutencao')">
            🛑 COLOCAR EM MANUTENÇÃO
        </button>

        <button class="app-button btn-green" onclick="comandoMudarStatus('online')">
            🟢 VOLTAR SITE ONLINE
        </button>

        <hr style="width:100%; border:0; border-top:1px solid #ccc; margin:10px 0;">

        <div class="app-label">Controle de Estoque Oculto:</div>
        
        <button class="app-button btn-blue" onclick="dispararNotificador('Loop de Marketing Resetado para 3!')">
            ♻️ RESETAR MÁXIMO (3 CARTELAS)
        </button>

    </div>

    <div id="notifier" class="app-notifier"></div>

    <script>
        function comandoMudarStatus(novoStatus) {
            const statusTela = document.getElementById('app-status-tela');
            if (novoStatus === 'manutencao') {
                statusTela.textContent = "● SITE EM MANUTENÇÃO";
                statusTela.className = "status-box status-manutencao";
                dispararNotificador("Comando Enviado: Site em Manutenção!");
            } else {
                statusTela.textContent = "● SITE ONLINE";
                statusTela.className = "status-box status-online";
                dispararNotificador("Comando Enviado: Site Aberto para Vendas!");
            }
        }

        function dispararNotificador(mensagem) {
            const caixaAlerta = document.getElementById('notifier');
            caixaAlerta.textContent = message = mensagem;
            caixaAlerta.style.display = 'block';
            tocarBipeSucesso();
            setTimeout(() => { caixaAlerta.style.display = 'none'; }, 3000);
        }

        function tocarBipeSucesso() {
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(880, audioCtx.currentTime); 
            gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.1);
        }
    </script>
</body>
</html>
